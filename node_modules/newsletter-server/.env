PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Email transport (dev default: ethereal test account + console log)
